    { title: "SEO Growth", description: "Data-driven SEO strategies to ensure maximum visibility and organic growth.", icon: "🔍" },
  ];

  useEffect(() => {
    const ctx = gsap.context(() => {
      gsap.from(".service-title", {
        y: 100,
        opacity: 0,
        duration: 1.2,
        ease: "power4.out",
        stagger: 0.2,
        scrollTrigger: {
